{
  "name": "@asuha/dsh-claude-model-provider",
  "version": "0.1.0-next.5",
  "description": "Unofficial subscription-only Claude SDK provider for DeepSeek Harness",
  "license": "MIT",
  "author": "asuhacoder",
  "type": "module",
  "bin": {
    "dsh-claude-model-provider": "./lib/provider-cli.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "AUTHORS.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.ja.md",
    "CHANGELOG.md",
    "RELEASE_STATUS.md",
    "COMPLIANCE.md",
    "CAPABILITY_REPORT.json",
    "compatibility.lock.json",
    "IMPLEMENTATION_REPORT.md",
    "BOOTSTRAP_CHECKLIST.md",
    "PRIVACY.md",
    "SECURITY.md",
    "docs/",
    "ops/incident-runbook.md",
    "ops/repair-runbook.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asuhacoder/dsh-claude-model-provider.git"
  },
  "bugs": {
    "url": "https://github.com/asuhacoder/dsh-claude-model-provider/issues"
  },
  "homepage": "https://github.com/asuhacoder/dsh-claude-model-provider#readme",
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "publint": "node scripts/run-publint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "test:install": "pnpm build && node scripts/verify-install.mjs",
    "test:coexist": "pnpm build && node scripts/verify-install.mjs --coexist",
    "test:live:single": "pnpm build && node scripts/live-smoke.mjs",
    "test:live:multi": "pnpm build && node scripts/live-multi.mjs",
    "bench:routing": "pnpm build && node scripts/bench-routing.mjs",
    "compat:probe": "node scripts/probe-upstream.mjs",
    "release:dry-run": "pnpm build && node scripts/check-pack.mjs && node scripts/release-dry-run.mjs",
    "test:ops": "node --test ops/*.test.mjs && node ops/fixture-e2e.mjs",
    "test:live:matrix": "pnpm build && node scripts/live-matrix.mjs",
    "test:live:hybrid": "pnpm build && node scripts/live-hybrid.mjs",
    "bench:forecast": "pnpm build && node scripts/bench-forecast.mjs",
    "test:live:interruption": "pnpm build && node scripts/live-interruption.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "playwright": "1.61.1",
    "pnpm": "11.1.2",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "contributors": [
    "snowan (upstream bridge foundation)"
  ]
}
